# ==============================================================================
# Gesture Flow — Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NEVER commit real credentials, passwords, or MongoDB connection strings to Git.
# ==============================================================================

# Backend Database (MongoDB Atlas)
MONGODB_URI=
MONGODB_DB=gesture_flow

# JWT Authentication Secret (32+ random characters)
JWT_SECRET=

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=False

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gestureflow.vercel.app,https://gesture-flow.vercel.app

# Frontend Backend API Target URL
# Local: http://localhost:8000
# Production Render: https://<render-backend-url>
VITE_API_URL=
